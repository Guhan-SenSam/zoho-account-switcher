{
  "manifest_version": 3,
  "name": "Zoho Account Switcher",
  "version": "1.0.0",
  "description": "Keep several Zoho accounts in one Chrome profile and switch between them in a click.",
  "key": "",
  "permissions": ["cookies", "storage", "scripting", "browsingData"],
  "host_permissions": [
    "*://*.zoho.com/*",
    "*://*.zoho.in/*",
    "*://*.zoho.eu/*",
    "*://*.zoho.com.au/*",
    "*://*.zoho.jp/*",
    "*://*.zoho.com.cn/*",
    "*://*.zoho.sa/*",
    "*://*.zoho.uk/*",
    "*://*.zohocloud.ca/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Zoho Account Switcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Open Zoho Account Switcher"
    }
  }
}
